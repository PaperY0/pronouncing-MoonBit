// Learn more about moon.mod configuration:
// https://docs.moonbitlang.com/en/latest/toolchain/moon/module.html

name = "PaperY0/pronouncing"

version = "0.1.2"

readme = "README.mbt.md"

repository = "https://github.com/PaperY0/pronouncing-MoonBit"

license = "MIT"

keywords = [
  "cmudict",
  "pronunciation",
  "arpabet",
  "ipa",
  "phonemes",
  "rhyme",
  "speech",
]

preferred_target = "wasm"

description = "MoonBit port of the CMU Pronouncing Dictionary + pronouncing: ARPABET phoneme lookup, ARPABET-to-IPA conversion, rhymes, syllable/stress analysis, phoneme regex search and phoneme edit distance. Pure computation, no IO."
